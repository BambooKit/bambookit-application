#!/bin/sh
set -e
# Typecheck before every push, with the bun version in package.json ("packageManager").
# keep the range in sync with packages/script/src/index.ts semver qualifier
# An older bun no longer blocks the push: the pinned version is fetched through npx for this run.
# Install it permanently with: curl -fsSL https://bun.sh/install | bash -s "bun-v<version>"   (see PUSHING.md)
expected=$(node -p "(require('./package.json').packageManager || '').split('@')[1] || ''")
if [ -z "$expected" ]; then
  echo "pre-push: packageManager field not found in root package.json" >&2
  exit 1
fi

if command -v bun >/dev/null 2>&1 && bun -e "process.exit(Bun.semver.satisfies(Bun.version, '^$expected') ? 0 : 1)" >/dev/null 2>&1; then
  BUN="bun"
  current=$(bun --version)
  if [ "$current" != "$expected" ]; then echo "pre-push: warning: bun $current differs from expected $expected" >&2; fi
else
  current=$(bun --version 2>/dev/null || echo "not installed")
  echo "pre-push: bun ^$expected is required (found $current); using npx bun@$expected for this push." >&2
  echo "pre-push: to install it permanently: curl -fsSL https://bun.sh/install | bash -s \"bun-v$expected\"" >&2
  BUN="npx -y bun@$expected"
fi

$BUN typecheck
