# Copy to .env.bambookit (gitignored) or export these variables before building.
# Dev builds default to http://localhost:8080; packaged builds to the hosted API.
BAMBOOKIT_API_URL=http://localhost:8080
BAMBOOKIT_SUPABASE_URL=https://your-project.supabase.co
# Supabase publishable/anon key (public client key). Never the service-role key.
BAMBOOKIT_SUPABASE_ANON_KEY=
# Firebase (Google sign-in). Public web config values from Firebase console → Project settings.
BAMBOOKIT_FIREBASE_API_KEY=
BAMBOOKIT_FIREBASE_PROJECT_ID=
BAMBOOKIT_FIREBASE_AUTH_DOMAIN=
